{
  "name": "mact-studio",
  "version": "1.0.0",
  "description": "MACT Studio - ROM/RAM loader, bank windows, memory watch and terminal for the MACT firmware (Multiple Arcade & Computer Tester)",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "author": "alexbrsc66",
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "io.github.alexbrsc66.mact",
    "productName": "MACT Studio",
    "afterPack": "build/afterPack.js",
    "files": [
      "main/**",
      "renderer/**",
      "build/icons/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icons/icon.icns",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "MACT Studio talks to the MACT board on your local network (ROM loader, memory watch and console)."
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "MACT-Studio-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "MACT-Studio-${version}-portable.${ext}"
    }
  },
  "homepage": "https://github.com/alexbrsc66/MACT"
}
